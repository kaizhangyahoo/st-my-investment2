# Unauthenticated span ingest: throttle per client IP so it cannot burn the vendor quota.
limit_req_zone $binary_remote_addr zone=otlp:1m rate=2r/s;

server {
    listen 80;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # Statement CSV uploads.
    client_max_body_size 20m;

    # Split routes (P2/P4). Upstreams default to the monolith, so without the split overlay
    # everything still reaches `backend`. A variable in proxy_pass forwards the URI unchanged.
    location ~ ^/api/v1/(market-data|tickers)/ {
        proxy_pass http://${DATA_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    location /api/v1/trading212/ {
        proxy_pass http://${T212_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Service-to-service routes are never public.
    location /api/v1/internal/ {
        return 404;
    }

    location /api/ {
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # History compute can take a while on a cold cache.
        proxy_read_timeout 300s;
    }

    location = /otlp/v1/traces {
        limit_except POST { deny all; }
        limit_req zone=otlp burst=20 nodelay;
        client_max_body_size 256k;
        proxy_pass http://otel-collector:4318/v1/traces;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /health {
        proxy_pass http://backend:8000/health;
    }

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
