# Application Settings
ENVIRONMENT=development
PROJECT_NAME="Portfolio Analytics API"
API_V1_STR=/api/v1

# Firebase Configuration
FIREBASE_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Broker & Market Data Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
EODHD_API_TOKEN=
FINAGE_API_KEY=
TWELVEDATA_API_KEY=

# Trading 212
T212_API_KEY=
T212_API_SECRET=

# JWT Secrets
JWT_SECRET=replace-with-a-secure-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Stitch MCP (used in mcp.json — copy to .env at repo root)
# Generate at: https://stitch.google.com -> Settings -> API key
STITCH_API_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=auto.  # auto=json under CloudRun, text locally)

# OpenTelemetry log export
OTEL_SERVICE_NAME=fastapi-portfolio
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-gb-south-1.grafana.net/otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base 64 of instanceID:token>
# Same credential, value only -- used by the otel-collector service for browser spans.
GRAFANA_OTLP_AUTHORIZATION=Basic <base 64 of instanceID:token>
OTEL_RESOURCE_ATTRIBUTES=service.namespace=st-my-investment2,deployment.environment=local-POC